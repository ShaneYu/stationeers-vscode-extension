{
  "schemaVersion": 1,
  "scenario": "./workbench.icsim",
  "cases": [
    {
      "name": "iron button request completes safely",
      "focusProgram": "requester",
      "maxTicks": 12,
      "initial": {
        "device(\"iron-button\").Activate": 0,
        "device(\"gold-button\").Activate": 0,
        "device(\"steel-button\").Activate": 0,
        "device(\"delivery-valve\").Open": 0
      },
      "timeline": [
        {
          "tick": 1,
          "set": {"device(\"iron-button\").Activate": 1}
        },
        {
          "tick": 2,
          "set": {"device(\"iron-button\").Activate": 0}
        }
      ],
      "expect": [
        {
          "expression": "r2",
          "expected": 0,
          "atTick": 1
        },
        {
          "eventually": "device(\"delivery-outlet\").slot[0].OccupantHash == -1301215609",
          "withinTicks": 8
        },
        {
          "always": "device(\"gold-vendor\").slot[2].Quantity == 50"
        }
      ],
      "snapshot": {
        "values": {
          "r2": 1,
          "device(\"iron-vendor\").slot[2].Occupied": 0,
          "device(\"gold-vendor\").slot[2].Occupied": 1,
          "device(\"delivery-valve\").Open": 0,
          "device(\"delivery-outlet\").ExportCount": 1
        }
      }
    },
    {
      "name": "gold button request completes",
      "focusProgram": "requester",
      "maxTicks": 12,
      "initial": {},
      "timeline": [
        {
          "tick": 1,
          "set": {"device(\"gold-button\").Activate": 1}
        },
        {
          "tick": 2,
          "set": {"device(\"gold-button\").Activate": 0}
        }
      ],
      "expect": [
        {
          "eventually": "device(\"delivery-outlet\").slot[0].OccupantHash == 226410516",
          "withinTicks": 8
        }
      ],
      "snapshot": {
        "values": {
          "device(\"delivery-valve\").Open": 0,
          "device(\"delivery-outlet\").ExportCount": 1
        }
      }
    },
    {
      "name": "preloaded request completes",
      "focusProgram": "requester",
      "maxTicks": 8,
      "initial": {
        "r0": "${requestedHash}"
      },
      "parameters": [
        {"name":"iron","requestedHash":-1301215609},
        {"name":"gold","requestedHash":226410516}
      ],
      "expect": [
        {
          "eventually": "device(\"delivery-outlet\").slot[0].Occupied == 1",
          "withinTicks": 5
        }
      ],
      "snapshot": {
        "values": {
          "device(\"delivery-valve\").Open": 0,
          "device(\"delivery-outlet\").ExportCount": 1
        }
      }
    },
    {
      "name": "steel button request stays safe when unavailable",
      "focusProgram": "requester",
      "maxTicks": 8,
      "timeline": [
        {
          "tick": 1,
          "set": {"device(\"steel-button\").Activate": 1}
        },
        {
          "tick": 2,
          "set": {"device(\"steel-button\").Activate": 0}
        }
      ],
      "expect": [
        {
          "always": "device(\"delivery-outlet\").ExportCount == 0"
        },
        {
          "always": "device(\"iron-vendor\").slot[2].Quantity == 50"
        },
        {
          "always": "device(\"gold-vendor\").slot[2].Quantity == 50"
        }
      ],
      "snapshot": {
        "values": {
          "r2": 0,
          "device(\"delivery-valve\").Open": 0,
          "device(\"delivery-outlet\").ExportCount": 0
        }
      }
    }
  ]
}
