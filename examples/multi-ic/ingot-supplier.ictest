{
  "schemaVersion": 1,
  "scenario": "./ingot-supplier.icsim",
  "cases": [
    {
      "name": "request iron and leave gold untouched",
      "focusProgram": "requester",
      "maxTicks": 8,
      "initial": {
        "r0": -1301215609
      },
      "expect": [
        {
          "eventually": "device(\"delivery-outlet\").slot[0].OccupantHash == -1301215609",
          "withinTicks": 5
        },
        {
          "always": "device(\"gold-vendor\").slot[2].Quantity == 50"
        }
      ],
      "snapshot": {
        "values": {
          "r2": 1,
          "device(\"iron-vendor\").slot[2].Occupied": 0,
          "device(\"gold-vendor\").slot[2].Occupied": 1,
          "device(\"delivery-valve\").Open": 0,
          "device(\"delivery-outlet\").ExportCount": 1
        }
      }
    },
    {
      "name": "request gold and leave iron untouched",
      "focusProgram": "requester",
      "maxTicks": 8,
      "initial": {
        "r0": 226410516
      },
      "expect": [
        {
          "eventually": "device(\"delivery-outlet\").slot[0].OccupantHash == 226410516",
          "withinTicks": 5
        },
        {
          "always": "device(\"iron-vendor\").slot[2].Quantity == 50"
        }
      ],
      "snapshot": {
        "values": {
          "r2": 1,
          "device(\"iron-vendor\").slot[2].Occupied": 1,
          "device(\"gold-vendor\").slot[2].Occupied": 0,
          "device(\"delivery-valve\").Open": 0,
          "device(\"delivery-outlet\").ExportCount": 1
        }
      }
    },
    {
      "name": "ignore an unknown ingot request",
      "focusProgram": "requester",
      "maxTicks": 6,
      "initial": {
        "r0": 123456
      },
      "expect": [
        {
          "always": "device(\"iron-vendor\").slot[2].Quantity == 50"
        },
        {
          "always": "device(\"gold-vendor\").slot[2].Quantity == 50"
        }
      ],
      "snapshot": {
        "values": {
          "r2": 0,
          "device(\"iron-vendor\").slot[2].Occupied": 1,
          "device(\"gold-vendor\").slot[2].Occupied": 1,
          "device(\"delivery-valve\").slot[0].Occupied": 0,
          "device(\"delivery-outlet\").ExportCount": 0
        }
      }
    }
  ]
}
