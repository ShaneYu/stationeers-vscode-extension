<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><AssemblyName>StationeersBridge.RemoteNetwork</AssemblyName><RootNamespace>StationeersBridge.RemoteNetwork</RootNamespace><Version>0.1.0</Version><Description>RemoteNetwork discovery anchor for Stationeers Bridge.</Description></PropertyGroup>
  <ItemGroup><ProjectReference Include="..\..\StationeersBridge.RemoteNetwork.Core\StationeersBridge.RemoteNetwork.Core.csproj" /></ItemGroup>

  <PropertyGroup>
    <!-- Override STATIONEERS_DOCUMENTS_DIR when Documents is redirected. -->
    <StationeersDocumentsDirectory Condition="'$(StationeersDocumentsDirectory)' == '' and '$(STATIONEERS_DOCUMENTS_DIR)' != ''">$(STATIONEERS_DOCUMENTS_DIR)</StationeersDocumentsDirectory>
    <StationeersDocumentsDirectory Condition="'$(StationeersDocumentsDirectory)' == '' and '$(USERPROFILE)' != ''">$(USERPROFILE)\Documents</StationeersDocumentsDirectory>
    <StationeersModsDirectory Condition="'$(StationeersModsDirectory)' == '' and '$(STATIONEERS_MODS_DIR)' != ''">$(STATIONEERS_MODS_DIR)</StationeersModsDirectory>
    <StationeersModsDirectory Condition="'$(StationeersModsDirectory)' == ''">$(StationeersDocumentsDirectory)\My Games\Stationeers\mods</StationeersModsDirectory>
    <StationeersRemoteNetworkInstallDirectory>$(StationeersModsDirectory)\StationeersBridge.RemoteNetwork</StationeersRemoteNetworkInstallDirectory>
    <DeployRemoteNetworkMod Condition="'$(DeployRemoteNetworkMod)' == ''">true</DeployRemoteNetworkMod>
  </PropertyGroup>

  <ItemGroup>
    <RemoteNetworkAbout Include="$(MSBuildThisFileDirectory)..\About\**\*" />
    <RemoteNetworkGameData Include="$(MSBuildThisFileDirectory)..\GameData\**\*" />
    <RemoteNetworkBinaries Include="$(TargetPath)" />
    <RemoteNetworkBinaries Include="$(TargetDir)StationeersBridge.RemoteNetwork.Core.dll" Condition="Exists('$(TargetDir)StationeersBridge.RemoteNetwork.Core.dll')" />
    <RemoteNetworkBinaries Include="$(TargetDir)StationeersBridge.RemoteNetwork.deps.json" Condition="Exists('$(TargetDir)StationeersBridge.RemoteNetwork.deps.json')" />
  </ItemGroup>

  <Target Name="DeployRemoteNetworkMod" AfterTargets="Build" Condition="'$(DeployRemoteNetworkMod)' == 'true' and '$(Configuration)' == 'Debug'">
    <RemoveDir Directories="$(StationeersRemoteNetworkInstallDirectory)" />
    <MakeDir Directories="$(StationeersRemoteNetworkInstallDirectory)" />
    <Copy SourceFiles="@(RemoteNetworkAbout)" DestinationFiles="@(RemoteNetworkAbout->'$(StationeersRemoteNetworkInstallDirectory)\About\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(RemoteNetworkGameData)" DestinationFiles="@(RemoteNetworkGameData->'$(StationeersRemoteNetworkInstallDirectory)\GameData\%(RecursiveDir)%(Filename)%(Extension)')" SkipUnchangedFiles="true" />
    <Copy SourceFiles="@(RemoteNetworkBinaries)" DestinationFolder="$(StationeersRemoteNetworkInstallDirectory)" SkipUnchangedFiles="true" />
    <Message Importance="High" Text="Deployed StationeersBridge.RemoteNetwork to $(StationeersRemoteNetworkInstallDirectory)" />
  </Target>
</Project>
