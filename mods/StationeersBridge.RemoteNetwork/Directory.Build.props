<Project>
  <PropertyGroup>
    <StationeersDirectory Condition="'$(StationeersDirectory)' == ''">$(STATIONEERS_DIR)</StationeersDirectory>
    <StationeersManagedDirectory>$(StationeersDirectory)\rocketstation_Data\Managed</StationeersManagedDirectory>
    <BepInExCoreDirectory>$(StationeersDirectory)\BepInEx\core</BepInExCoreDirectory>
    <LaunchPadDirectory>$(StationeersDirectory)\BepInEx\plugins\StationeersLaunchPad</LaunchPadDirectory>
    <TargetFramework>netstandard2.1</TargetFramework><LangVersion>12.0</LangVersion><Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors><Deterministic>true</Deterministic>
    <NoStandardLibraries>true</NoStandardLibraries><NoStdLib>true</NoStdLib><NoConfig>true</NoConfig>
    <DisableImplicitFrameworkReferences>true</DisableImplicitFrameworkReferences>
    <NoWarn>$(NoWarn);MSB3277</NoWarn><OutputPath>$(MSBuildThisFileDirectory)bin\$(Configuration)\</OutputPath>
    <BaseIntermediateOutputPath>$(MSBuildThisFileDirectory)obj\</BaseIntermediateOutputPath>
  </PropertyGroup>
  <ItemGroup>
    <GameReference Include="mscorlib" GameDirectory="$(StationeersManagedDirectory)" /><GameReference Include="netstandard" GameDirectory="$(StationeersManagedDirectory)" />
    <GameReference Include="System" GameDirectory="$(StationeersManagedDirectory)" /><GameReference Include="System.Core" GameDirectory="$(StationeersManagedDirectory)" />
    <GameReference Include="Assembly-CSharp" GameDirectory="$(StationeersManagedDirectory)" /><GameReference Include="UnityEngine" GameDirectory="$(StationeersManagedDirectory)" />
    <GameReference Include="UnityEngine.CoreModule" GameDirectory="$(StationeersManagedDirectory)" /><GameReference Include="UnityEngine.AnimationModule" GameDirectory="$(StationeersManagedDirectory)" /><GameReference Include="BepInEx" GameDirectory="$(BepInExCoreDirectory)" />
    <GameReference Include="LaunchPadBooster" GameDirectory="$(LaunchPadDirectory)" />
    <_GameReferenceCandidate Include="@(GameReference->'%(GameDirectory)\%(Identity).dll')" /><_GameReferenceResolved Include="@(_GameReferenceCandidate->Exists())" Path="%(FullPath)" />
    <Reference Include="@(_GameReferenceResolved->'%(Filename)')" HintPath="%(Path)" Private="false" /><_MissingGameReference Include="@(GameReference)" Exclude="@(Reference)" />
  </ItemGroup>
  <Target Name="ValidateStationeersDirectory" BeforeTargets="PrepareForBuild">
    <Error Condition="'$(StationeersDirectory)' == ''" Text="Set STATIONEERS_DIR or pass -p:StationeersDirectory=&lt;path-to-Stationeers&gt;." />
    <Error Condition="!Exists('$(StationeersManagedDirectory)\Assembly-CSharp.dll')" Text="Missing Stationeers Assembly-CSharp.dll." />
    <Error Condition="'@(_MissingGameReference)' != ''" Text="Missing local game reference(s): @(_MissingGameReference)." />
  </Target>
</Project>
