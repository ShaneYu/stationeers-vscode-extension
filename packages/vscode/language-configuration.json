{
  "comments": {
    "lineComment": "#"
  },
  "brackets": [
    [
      "(",
      ")"
    ]
  ],
  "autoClosingPairs": [
    {
      "open": "\"",
      "close": "\"",
      "notIn": [
        "comment"
      ]
    },
    [
      "(",
      ")"
    ]
  ],
  "surroundingPairs": [
    [
      "\"",
      "\""
    ],
    [
      "(",
      ")"
    ]
  ],
  "wordPattern": "(-?\\d*\\.\\d\\w*)|([^\\s#(),]+)"
}

