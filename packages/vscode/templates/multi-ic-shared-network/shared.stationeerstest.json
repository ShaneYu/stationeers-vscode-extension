{
  "schemaVersion": 1,
  "scenario": "./shared.stationeerssim.json",
  "cases": [
    {
      "name": "coordinates default value over shared channel",
      "focusProgram": "subscriber",
      "maxTicks": 3,
      "expect": [
        {
          "eventually": "network(\"shared\").Channel0 == 42",
          "withinTicks": 1
        },
        {
          "eventually": "device(\"received-value\").Setting == 42",
          "withinTicks": 2
        }
      ]
    },
    {
      "name": "coordinates alternate and cleared values",
      "focusProgram": "subscriber",
      "maxTicks": 4,
      "timeline": [
        {
          "tick": 0,
          "set": {
            "device(\"published-value\").Setting": 7
          }
        },
        {
          "tick": 2,
          "set": {
            "device(\"published-value\").Setting": 0
          }
        }
      ],
      "expect": [
        {
          "expression": "device(\"received-value\").Setting",
          "expected": 7,
          "atTick": 1
        },
        {
          "eventually": "device(\"received-value\").Setting == 0",
          "withinTicks": 3
        }
      ]
    }
  ]
}
