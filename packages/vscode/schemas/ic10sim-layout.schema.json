{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shaneyu.dev/stationeers/ic10sim-layout.schema.json",
  "title": "IC10 Simulation Topology Layout",
  "description": "Non-semantic visual positions for an IC10 simulation environment.",
  "type": "object",
  "required": [
    "schemaVersion",
    "nodes"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "nodes": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/point"
      }
    },
    "viewport": {
      "type": "object",
      "required": [
        "x",
        "y",
        "zoom"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": -1000000,
          "maximum": 1000000
        },
        "y": {
          "type": "number",
          "minimum": -1000000,
          "maximum": 1000000
        },
        "zoom": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 8
        }
      },
      "additionalProperties": false
    }
  },
  "additionalProperties": false,
  "$defs": {
    "point": {
      "type": "object",
      "required": [
        "x",
        "y"
      ],
      "properties": {
        "x": {
          "type": "number",
          "minimum": -1000000,
          "maximum": 1000000
        },
        "y": {
          "type": "number",
          "minimum": -1000000,
          "maximum": 1000000
        }
      },
      "additionalProperties": false
    }
  }
}
