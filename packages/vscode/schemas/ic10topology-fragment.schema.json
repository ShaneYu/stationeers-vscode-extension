{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shaneyu.dev/stationeers/ic10topology-fragment.schema.json",
  "title": "IC10 Topology Fragment",
  "type": "object",
  "required": [
    "schemaVersion",
    "networks",
    "devices"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "networks": {
      "type": "array",
      "items": {
        "$ref": "ic10sim.schema.json#/$defs/network"
      }
    },
    "devices": {
      "type": "array",
      "items": {
        "$ref": "ic10sim.schema.json#/$defs/device"
      }
    },
    "layout": {
      "$ref": "ic10sim-layout.schema.json"
    }
  },
  "anyOf": [
    {
      "properties": {
        "networks": {
          "minItems": 1
        }
      }
    },
    {
      "properties": {
        "devices": {
          "minItems": 1
        }
      }
    }
  ],
  "additionalProperties": false
}
