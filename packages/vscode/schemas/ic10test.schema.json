{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shaneyu.dev/stationeers/ic10test.schema.json",
  "title": "IC10 Scenario Test",
  "type": "object",
  "required": ["schemaVersion", "scenario", "cases"],
  "properties": {
    "schemaVersion": {
      "const": 1,
      "description": "The test fixture schema version. See docs/scenario-testing.md before changing this value."
    },
    "scenario": {
      "type": "string",
      "minLength": 1,
      "description": "Path to a reusable .ic10sim.json file, relative to this test file."
    },
    "seed": {
      "type": "integer",
      "minimum": 0,
      "default": 0
    },
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/case" }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "scalar": {
      "oneOf": [
        { "type": "number" },
        { "enum": ["NaN", "Infinity", "-Infinity", "-0"] }
      ]
    },
    "stateMap": {
      "type": "object",
      "propertyNames": {
        "pattern": "^(?:r(?:[0-9]|1[0-7])|ra|sp|stack\\[[0-9]+\\]|device\\(\"[^\"]+\"\\)\\.(?:[A-Za-z][A-Za-z0-9]*|slot\\[[0-9]+\\]\\.[A-Za-z][A-Za-z0-9]*|memory\\[[0-9]+\\])|network\\(\"[^\"]+\"\\)\\.Channel[0-7])$"
      },
      "additionalProperties": { "$ref": "#/$defs/scalar" }
    },
    "tolerance": {
      "type": "object",
      "properties": {
        "absolute": { "type": "number", "minimum": 0, "default": 0 },
        "relative": { "type": "number", "minimum": 0, "default": 0 }
      },
      "additionalProperties": false
    },
    "assertion": {
      "type": "object",
      "properties": {
        "expression": { "type": "string", "minLength": 1 },
        "eventually": { "type": "string", "minLength": 1 },
        "always": { "type": "string", "minLength": 1 },
        "atTick": { "type": "integer", "minimum": 0 },
        "withinTicks": { "type": "integer", "minimum": 0 },
        "expected": { "$ref": "#/$defs/scalar" },
        "tolerance": { "$ref": "#/$defs/tolerance" }
      },
      "oneOf": [
        { "required": ["expression"] },
        { "required": ["eventually"] },
        { "required": ["always"] }
      ],
      "additionalProperties": false
    },
    "timeline": {
      "type": "object",
      "required": ["tick"],
      "properties": {
        "tick": { "type": "integer", "minimum": 0 },
        "set": { "$ref": "#/$defs/stateMap" },
        "events": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["target", "value"],
            "properties": {
              "target": { "type": "string" },
              "value": { "$ref": "#/$defs/scalar" }
            },
            "additionalProperties": false
          }
        }
      },
      "additionalProperties": false
    },
    "error": {
      "type": "object",
      "required": ["kind"],
      "properties": {
        "kind": { "enum": ["compile", "runtime"] },
        "messageContains": { "type": "string" }
      },
      "additionalProperties": false
    },
    "snapshot": {
      "type": "object",
      "required": ["values"],
      "properties": {
        "values": {
          "type": "object",
          "additionalProperties": { "$ref": "#/$defs/scalar" }
        }
      },
      "additionalProperties": false
    },
    "case": {
      "type": "object",
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "maxTicks": { "type": "integer", "minimum": 1, "default": 100 },
        "maxOperations": { "type": "integer", "minimum": 1, "default": 100000 },
        "focusIc": { "type": "string", "minLength": 1 },
        "initial": { "$ref": "#/$defs/stateMap" },
        "timeline": {
          "type": "array",
          "items": { "$ref": "#/$defs/timeline" }
        },
        "expect": {
          "type": "array",
          "items": { "$ref": "#/$defs/assertion" }
        },
        "expectError": { "$ref": "#/$defs/error" },
        "parameters": {
          "type": "array",
          "items": {
            "type": "object",
            "minProperties": 1,
            "properties": { "name": { "type": "string" } },
            "additionalProperties": {
              "type": ["string", "number", "boolean"]
            }
          }
        },
        "snapshot": { "$ref": "#/$defs/snapshot" }
      },
      "additionalProperties": false
    }
  }
}
