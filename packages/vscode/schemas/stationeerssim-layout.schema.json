{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://shaneyu.dev/stationeers/stationeerssim-layout.schema.json",
  "title": "Stationeers Simulation Layout",
  "description": "Language-neutral visual positions for a Stationeers simulation.",
  "type": "object",
  "required": ["schemaVersion", "nodes"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "nodes": { "type": "object", "additionalProperties": { "$ref": "ic10sim-layout.schema.json#/$defs/point" } },
    "viewport": { "$ref": "ic10sim-layout.schema.json#/properties/viewport" }
  },
  "additionalProperties": false
}
