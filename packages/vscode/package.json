{
  "name": "stationeers",
  "displayName": "Stationeers IC10 Toolkit",
  "description": "Unofficial IC10 language support for Stationeers, powered by a native Rust language server.",
  "version": "0.1.2",
  "publisher": "shaneyu",
  "repository": {
    "type": "git",
    "url": "https://github.com/ShaneYu/stationeers-vscode-extension.git",
    "directory": "packages/vscode"
  },
  "homepage": "https://github.com/ShaneYu/stationeers-vscode-extension",
  "bugs": {
    "url": "https://github.com/ShaneYu/stationeers-vscode-extension/issues"
  },
  "license": "MIT",
  "icon": "assets/icon.png",
  "galleryBanner": {
    "color": "#071426",
    "theme": "dark"
  },
  "pricing": "Free",
  "private": true,
  "engines": {
    "vscode": "^1.125.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "keywords": [
    "stationeers",
    "ic10",
    "mips",
    "language server",
    "lsp"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "activationEvents": [
    "onLanguage:ic10"
  ],
  "main": "./dist/extension.js",
  "files": [
    "assets/",
    "dist/",
    "language-configuration.json",
    "server/",
    "syntaxes/",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "SUPPORT.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "contributes": {
    "languages": [
      {
        "id": "ic10",
        "aliases": [
          "Stationeers IC10",
          "IC10"
        ],
        "extensions": [
          ".ic10"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ic10",
        "scopeName": "source.ic10",
        "path": "./syntaxes/ic10.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "ic10.restartServer",
        "title": "IC10: Restart Language Server"
      },
      {
        "command": "ic10.removeAllComments",
        "title": "IC10: Remove All Comments",
        "enablement": "editorLangId == ic10"
      }
    ],
    "menus": {
      "editor/context": [
        {
          "command": "ic10.removeAllComments",
          "when": "editorLangId == ic10",
          "group": "1_modification@100"
        }
      ]
    },
    "configuration": {
      "title": "Stationeers IC10 Toolkit",
      "properties": {
        "ic10.server.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Absolute path to an ic10-lsp executable. Leave empty to use the bundled server."
        },
        "ic10.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "scope": "window",
          "description": "Trace communication between VS Code and the IC10 language server."
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/esbuild.mjs --production",
    "build:dev": "node scripts/esbuild.mjs",
    "check": "tsc --noEmit",
    "dev": "node scripts/esbuild.mjs --watch",
    "package": "npm run prepare:package && node scripts/package-extension.mjs",
    "prepare:package": "cargo build --release --locked -p ic10-lsp && node scripts/stage-server.mjs && npm run build",
    "test": "node --experimental-strip-types --test src/**/*.test.ts && tsc --noEmit"
  },
  "dependencies": {
    "vscode-languageclient": "10.1.0"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/vscode": "1.125.0",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.28.1",
    "ovsx": "1.0.2",
    "typescript": "7.0.2"
  }
}
