{
  "name": "stationeers",
  "displayName": "Stationeers IC10 Toolkit",
  "description": "Unofficial IC10 language support for Stationeers, powered by a native Rust language server.",
  "version": "0.3.1",
  "publisher": "shaneyu",
  "repository": {
    "type": "git",
    "url": "https://github.com/ShaneYu/stationeers-vscode-extension.git",
    "directory": "packages/vscode"
  },
  "homepage": "https://github.com/ShaneYu/stationeers-vscode-extension",
  "bugs": {
    "url": "https://github.com/ShaneYu/stationeers-vscode-extension/issues"
  },
  "license": "MIT",
  "icon": "assets/icon.png",
  "galleryBanner": {
    "color": "#071426",
    "theme": "dark"
  },
  "pricing": "Free",
  "private": true,
  "engines": {
    "vscode": "^1.107.0"
  },
  "categories": [
    "Programming Languages",
    "Debuggers"
  ],
  "keywords": [
    "stationeers",
    "ic10",
    "mips",
    "language server",
    "lsp"
  ],
  "extensionKind": [
    "workspace"
  ],
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": true
    }
  },
  "activationEvents": [
    "onLanguage:ic10",
    "onLanguage:lua",
    "workspaceContains:**/*.lua",
    "onDebug:ic10",
    "onCustomEditor:ic10.environment",
    "onCustomEditor:ic10.scenarioTest",
    "onView:ic10.state",
    "onView:stationeers.liveNetworks",
    "workspaceContains:**/*.stationeerssim.json",
    "workspaceContains:**/*.stationeerstest.json",
    "workspaceContains:**/*.ic10sim.json",
    "workspaceContains:**/*.ic10test.json"
  ],
  "extensionDependencies": [
    "sumneko.lua"
  ],
  "main": "./dist/extension.js",
  "files": [
    "assets/",
    "dist/",
    "language-configuration.json",
    "reference/",
    "schemas/",
    "server/",
    "templates/",
    "syntaxes/",
    "CHANGELOG.md",
    "LICENSE",
    "README.md",
    "SUPPORT.md",
    "THIRD_PARTY_NOTICES.md"
  ],
  "contributes": {
    "languages": [
      {
        "id": "ic10",
        "aliases": [
          "Stationeers IC10",
          "IC10"
        ],
        "extensions": [".ic10"],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "ic10",
        "scopeName": "source.ic10",
        "path": "./syntaxes/ic10.tmLanguage.json"
      }
    ],
    "commands": [
      {
        "command": "stationeers.live.connect",
        "title": "Stationeers: Connect Bridge"
      },
      {
        "command": "stationeers.live.pair",
        "title": "Stationeers: Pair Bridge"
      },
      {
        "command": "stationeers.live.disconnect",
        "title": "Stationeers: Disconnect Bridge"
      },
      {
        "command": "stationeers.live.refresh",
        "title": "Stationeers: Refresh Live Networks",
        "icon": "$(refresh)"
      },
      {
        "command": "stationeers.live.search",
        "title": "Stationeers: Filter Live Networks",
        "icon": "$(search)"
      },
      {
        "command": "stationeers.live.clearFilter",
        "title": "Stationeers: Clear Live Network Filter",
        "icon": "$(clear-all)"
      },
      {
        "command": "stationeers.live.pull",
        "title": "Stationeers: Pull Live Source",
        "icon": "$(cloud-download)"
      },
      {
        "command": "stationeers.live.push",
        "title": "Stationeers: Push Live Source",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "stationeers.live.compare",
        "title": "Stationeers: Compare with Live Source",
        "icon": "$(compare-changes)"
      },
      {
        "command": "stationeers.live.copyReference",
        "title": "Stationeers: Copy Housing Reference",
        "icon": "$(copy)"
      },
      {
        "command": "ic10.restartServer",
        "title": "IC10: Restart Language Server"
      },
      {
        "command": "ic10.removeAllComments",
        "title": "IC10: Remove All Comments",
        "enablement": "editorLangId == ic10"
      },
      {
        "command": "ic10.buildForGame",
        "title": "IC10: Build for Game",
        "enablement": "editorLangId == ic10"
      },
      {
        "command": "ic10.copyDeployableCode",
        "title": "IC10: Copy Deployable Code",
        "enablement": "editorLangId == ic10"
      },
      {
        "command": "ic10.openBuiltCode",
        "title": "IC10: Open Built Code",
        "enablement": "editorLangId == ic10"
      },
      {
        "command": "ic10.createEnvironment",
        "title": "IC10: Create Simulation Environment"
      },
      {
        "command": "ic10.createEnvironmentFromTemplate",
        "title": "IC10: Create Environment from Template"
      },
      {
        "command": "ic10.createScenarioTest",
        "title": "IC10: Create Scenario Test"
      },
      {
        "command": "ic10.configureLuaIntegration",
        "title": "Stationeers: Configure Lua 5.2 Integration"
      },
      {
        "command": "ic10.stepWorldTick",
        "title": "IC10: Step World Tick",
        "icon": "$(sync)"
      },
      {
        "command": "ic10.hotReload",
        "title": "IC10: Hot Reload Paused Simulation"
      },
      {
        "command": "ic10.exportTrace",
        "title": "IC10: Export Debug Trace"
      },
      {
        "command": "ic10.showTraceSummary",
        "title": "IC10: Show Trace, Coverage, and Profile"
      },
      {
        "command": "ic10.selectEnvironmentContext",
        "title": "IC10: Select Simulation Context"
      },
      {
        "command": "ic10.openEnvironmentTarget",
        "title": "IC10: Open Simulation Environment Object"
      }
    ],
    "breakpoints": [
      {
        "language": "ic10"
      }
    ],
    "debuggers": [
      {
        "type": "ic10",
        "label": "Stationeers IC10",
        "languages": [
          "ic10"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "scenario"
            ],
            "properties": {
              "scenario": {
                "type": "string",
                "description": "Path to a .stationeerssim.json or legacy .ic10sim.json simulation environment."
              },
              "focusIc": {
                "type": "string",
                "description": "Stable ID of the IC housing selected when the debugger starts."
              },
              "stopOnEntry": {
                "type": "boolean",
                "default": true,
                "description": "Pause before the first IC10 instruction."
              },
              "enableHistory": {
                "type": "boolean",
                "default": true,
                "description": "Record bounded checkpoints and replay events for reverse debugging."
              },
              "historyEvents": {
                "type": "integer",
                "minimum": 2,
                "default": 20000,
                "description": "Maximum retained reversible-debugging events."
              },
              "checkpointInterval": {
                "type": "integer",
                "minimum": 1,
                "default": 10000,
                "description": "Instructions between mutable-state checkpoints."
              },
              "historyMemoryMiB": {
                "type": "integer",
                "minimum": 1,
                "default": 64,
                "description": "Approximate memory ceiling for retained events and checkpoints."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "ic10",
            "request": "launch",
            "name": "IC10: Debug simulation",
            "scenario": "${workspaceFolder}/simulation.stationeerssim.json",
            "stopOnEntry": true
          }
        ],
        "configurationSnippets": [
          {
            "label": "IC10: Debug simulation",
            "description": "Debug all ICs in a shared simulation environment.",
            "body": {
              "type": "ic10",
              "request": "launch",
              "name": "IC10: Debug ${1:simulation}",
              "scenario": "${workspaceFolder}/${2:simulation.stationeerssim.json}",
              "stopOnEntry": true
            }
          }
        ]
      }
    ],
    "customEditors": [
      {
        "viewType": "ic10.environment",
        "displayName": "IC10 Simulation Environment",
        "selector": [
          {
            "filenamePattern": "*.stationeerssim.json"
          },
          {
            "filenamePattern": "*.ic10sim.json"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "ic10.scenarioTest",
        "displayName": "IC10 Scenario Test",
        "selector": [
          {
            "filenamePattern": "*.stationeerstest.json"
          },
          {
            "filenamePattern": "*.ic10test.json"
          }
        ],
        "priority": "default"
      }
    ],
    "viewsContainers": {
      "activitybar": [
        {
          "id": "stationeers",
          "title": "Stationeers",
          "icon": "$(broadcast)"
        }
      ]
    },
    "views": {
      "stationeers": [
        {
          "id": "stationeers.liveNetworks",
          "name": "Live Networks",
          "contextualTitle": "Stationeers Live Networks"
        }
      ],
      "debug": [
        {
          "type": "webview",
          "id": "ic10.state",
          "name": "IC10 State",
          "when": "debugType == ic10"
        }
      ]
    },
    "jsonValidation": [
      {
        "fileMatch": "*.stationeerssim.json",
        "url": "./schemas/stationeerssim.schema.json"
      },
      {
        "fileMatch": "*.ic10sim.json",
        "url": "./schemas/ic10sim.schema.json"
      },
      {
        "fileMatch": "*.stationeerstest.json",
        "url": "./schemas/stationeerstest.schema.json"
      },
      {
        "fileMatch": "*.ic10test.json",
        "url": "./schemas/ic10test.schema.json"
      },
      {
        "fileMatch": "*.stationeerssim.layout.json",
        "url": "./schemas/stationeerssim-layout.schema.json"
      },
      {
        "fileMatch": "*.ic10sim.layout.json",
        "url": "./schemas/ic10sim-layout.schema.json"
      },
      {
        "fileMatch": "*.ic10topology.json",
        "url": "./schemas/ic10topology-fragment.schema.json"
      }
    ],
    "problemMatchers": [
      {
        "name": "ic10-build",
        "label": "IC10 deployment build",
        "owner": "ic10-build",
        "fileLocation": [
          "relative",
          "${workspaceFolder}"
        ],
        "pattern": {
          "regexp": "^(.+):(\\d+):(\\d+):\\s+(error|warning)\\[([^\\]]+)\\]:\\s+(.*)$",
          "file": 1,
          "line": 2,
          "column": 3,
          "severity": 4,
          "code": 5,
          "message": 6
        }
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "stationeers.live.refresh",
          "when": "view == stationeers.liveNetworks && stationeers.bridge.connected",
          "group": "navigation@2"
        },
        {
          "command": "stationeers.live.search",
          "when": "view == stationeers.liveNetworks && stationeers.bridge.connected",
          "group": "navigation@3"
        },
        {
          "command": "stationeers.live.clearFilter",
          "when": "view == stationeers.liveNetworks && stationeers.bridge.connected && stationeers.bridge.filterActive",
          "group": "navigation@4"
        }
      ],
      "view/item/context": [
        {
          "command": "stationeers.live.pull",
          "when": "view == stationeers.liveNetworks && (viewItem == liveIc10Chip || viewItem == liveLuaChip) && stationeers.liveChip.canRead && !stationeers.liveChip.stale",
          "group": "inline@1"
        },
        {
          "command": "stationeers.live.push",
          "when": "view == stationeers.liveNetworks && (viewItem == liveIc10Chip || viewItem == liveLuaChip) && stationeers.liveChip.canPush && !stationeers.liveChip.stale",
          "group": "inline@2"
        },
        {
          "command": "stationeers.live.compare",
          "when": "view == stationeers.liveNetworks && (viewItem == liveIc10Chip || viewItem == liveLuaChip) && stationeers.liveChip.canCompare && !stationeers.liveChip.stale",
          "group": "inline@3"
        },
        {
          "command": "stationeers.live.copyReference",
          "when": "view == stationeers.liveNetworks && (viewItem == liveIc10Chip || viewItem == liveLuaChip) && stationeers.liveChip.available && !stationeers.liveChip.stale",
          "group": "inline@4"
        }
      ],
      "editor/context": [
        {
          "command": "ic10.removeAllComments",
          "when": "editorLangId == ic10",
          "group": "1_modification@100"
        },
        {
          "command": "ic10.buildForGame",
          "when": "editorLangId == ic10",
          "group": "1_modification@110"
        }
      ],
      "debug/toolBar": [
        {
          "command": "ic10.stepWorldTick",
          "when": "debugType == ic10 && inDebugMode",
          "group": "navigation@60"
        }
      ]
    },
    "configuration": {
      "title": "Stationeers IC10 Toolkit",
      "properties": {
        "ic10.server.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Absolute path to an ic10-lsp executable. Leave empty to use the bundled server."
        },
        "ic10.trace.server": {
          "type": "string",
          "enum": [
            "off",
            "messages",
            "verbose"
          ],
          "default": "off",
          "scope": "window",
          "description": "Trace communication between VS Code and the IC10 language server."
        },
        "ic10.diagnostics.unused": {
          "type": "string",
          "enum": [
            "off",
            "hint",
            "warning"
          ],
          "enumDescriptions": [
            "Do not report unused declarations or unreachable code.",
            "Show unused declarations and unreachable code as subtle unnecessary-code hints.",
            "Show unused declarations and unreachable code as warnings."
          ],
          "default": "hint",
          "scope": "resource",
          "description": "Controls diagnostics for unused labels, aliases, defines, and unreachable code."
        },
        "ic10.build.optimization": {
          "type": "string",
          "enum": [
            "none",
            "readable",
            "compact"
          ],
          "enumDescriptions": [
            "Validate and emit the source exactly.",
            "Remove comments and blank lines while preserving names.",
            "Also substitute safe defines and labels and shorten underscore-prefixed private aliases."
          ],
          "default": "readable",
          "scope": "resource",
          "description": "Controls safe transformations used for deployment builds."
        },
        "ic10.build.outputDirectory": {
          "type": "string",
          "default": "build",
          "scope": "resource",
          "description": "Directory for deployable code and JSON sidecars, relative to each source program's folder unless absolute."
        },
        "ic10.build.gameVersion": {
          "type": "string",
          "default": "",
          "scope": "resource",
          "description": "Optional exact Stationeers version. Builds fail when it does not match the bundled official generated data."
        },
        "ic10.debugAdapter.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Absolute path to an ic10-dap executable. Leave empty to use the bundled debug adapter."
        },
        "ic10.debug.history.enabled": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Record bounded history during debug sessions for Step Back and Reverse Continue."
        },
        "ic10.debug.history.events": {
          "type": "integer",
          "default": 20000,
          "minimum": 2,
          "maximum": 1000000,
          "scope": "resource",
          "description": "Maximum instruction events retained for reverse debugging."
        },
        "ic10.debug.history.checkpointInterval": {
          "type": "integer",
          "default": 10000,
          "minimum": 1,
          "maximum": 10000,
          "scope": "resource",
          "description": "Number of events between compact mutable-state checkpoints."
        },
        "ic10.debug.history.memoryMiB": {
          "type": "integer",
          "default": 64,
          "minimum": 1,
          "maximum": 4096,
          "scope": "resource",
          "description": "Approximate memory ceiling for reversible-debugging events and checkpoints."
        },
        "ic10.cli.path": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Absolute path to the ic10 command-line runner. Leave empty to use the bundled CLI."
        },
        "ic10.testing.rerunOnSave": {
          "type": "boolean",
          "default": false,
          "scope": "resource",
          "description": "Automatically re-run affected scenario tests when a referenced source or scenario is saved."
        },
        "stationeers.bridge.url": {
          "type": "string",
          "default": "http://127.0.0.1:3032",
          "scope": "machine",
          "description": "Authenticated local Stationeers bridge endpoint. Only loopback URLs are accepted; the pairing token is stored in SecretStorage."
        },
        "stationeers.stationeersLua.url": {
          "type": "string",
          "default": "http://127.0.0.1:3030",
          "scope": "machine",
          "description": "StationeersLua public REST endpoint. Only loopback URLs are accepted. Lua chips remain globally visible through the bridge, but source actions require the chip to be accessible through the current StationeersLua editor or Wireless Development Board scope."
        }
      }
    }
  },
  "scripts": {
    "build": "node scripts/esbuild.mjs --production",
    "build:dev": "node scripts/esbuild.mjs",
    "check": "tsc --noEmit",
    "dev": "node scripts/esbuild.mjs --watch",
    "package": "npm run prepare:package && node scripts/package-extension.mjs",
    "prepare:package": "cargo build --release --locked -p ic10-lsp -p ic10-dap -p ic10-runner && node scripts/stage-server.mjs && npm run build",
    "test": "node scripts/run-tests.mjs && tsc --noEmit",
    "test:extension-host": "node test/extension-host/run.mjs",
    "test:extension-host:keyboard": "node test/extension-host/run-keyboard.mjs"
  },
  "dependencies": {
    "vscode-languageclient": "10.1.0"
  },
  "devDependencies": {
    "@types/node": "26.1.1",
    "@types/vscode": "1.107.0",
    "@vscode/test-electron": "^2.5.2",
    "@vscode/vsce": "3.9.2",
    "esbuild": "0.28.1",
    "ovsx": "1.0.2",
    "typescript": "7.0.2"
  }
}
