{
  "editor.formatOnSave": true,
  "files.exclude": {
    "**/__pycache__": true,
    "**/target": true
  },
  "rust-analyzer.cargo.allTargets": true,
  "rust-analyzer.check.command": "clippy",
  "[ic10]": {
    "editor.defaultFormatter": null,
    "editor.quickSuggestions": {
      "comments": false,
      "other": true,
      "strings": true
    }
  }
}

