{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Run IC10 Extension",
      "type": "extensionHost",
      "request": "launch",
      "args": [
        "--extensionDevelopmentPath=${workspaceFolder}/packages/vscode",
        "--disable-extension=editorconfig.editorconfig"
      ],
      "outFiles": [
        "${workspaceFolder}/packages/vscode/dist/**/*.js"
      ],
      "preLaunchTask": "build: all"
    }
  ]
}
